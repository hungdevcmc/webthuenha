# ==== Biến PUBLIC (được đưa vào bundle trình duyệt, an toàn để công khai) ====
# Lấy tại Supabase Dashboard > Project Settings > API (hoặc: npx supabase projects api-keys --project-ref <ref>)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Dùng "publishable key" (sb_publishable_...) hoặc "anon key" (eyJ...) – cả hai đều là khóa công khai, bị RLS ràng buộc
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
# Địa chỉ website production (dùng cho SEO / Open Graph)
NEXT_PUBLIC_SITE_URL=https://ten-du-an.vercel.app

# ==== Biến BÍ MẬT – CHỈ dùng cho script trên máy bạn (scripts/create-admin.mjs, scripts/seed.mjs) ====
# TUYỆT ĐỐI không đưa lên Vercel, không commit, không dùng trong mã nguồn Next.js.
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxx
